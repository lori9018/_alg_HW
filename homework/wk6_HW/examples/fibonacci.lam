# ============================================================
# Church 編碼：費氏數列 fibonacci
# ------------------------------------------------------------
# fib 0 = 0
# fib 1 = 1
# fib n = fib (n-1) + fib (n-2)   (n >= 2)
# 最後一行 fib 4 是要計算的目標運算式。
# ============================================================

# --- 布林值 ---
true  = \x. \y. x
false = \x. \y. y

# --- Church 數 ---
one  = \f. \x. f x
plus = \m. \n. \f. \x. m f (n f x)

# iszero n：n 是否為 0
iszero = \n. n (\x. false) true

# pred n = n - 1
pred = \n. \f. \x. n (\g. \h. h (g f)) (\u. x) (\u. u)

# --- 遞迴：Y 組合子 ---
Y = \f. (\x. f (x x)) (\x. f (x x))

# --- 費氏數列 ---
# fib n = if (n <= 1) then n else fib (n-1) + fib (n-2)
# 其中 n <= 1 等同 iszero (pred n)
fib = Y (\f. \n. (iszero (pred n)) n (plus (f (pred n)) (f (pred (pred n)))))

# --- 計算 fib(4) = 3 ---
fib 4
